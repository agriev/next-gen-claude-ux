{
  "name": "interactive-jarvis",
  "private": true,
  "version": "0.1.0",
  "description": "Spatial multi-agent personal research tool — the Claude UI you actually wanted.",
  "main": "./out/main/index.js",
  "type": "module",
  "author": {
    "name": "Anton Griev",
    "email": "a.s.griev@gmail.com"
  },
  "license": "MIT",
  "homepage": "https://github.com/agriev/next-gen-claude-ux#readme",
  "bugs": {
    "url": "https://github.com/agriev/next-gen-claude-ux/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/agriev/next-gen-claude-ux.git"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "ar-audit": "bash scripts/ar-audit.sh",
    "rebuild": "electron-rebuild -f -w better-sqlite3",
    "pack:dir": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:linux": "npm run build && electron-builder --linux",
    "dist:win": "npm run build && electron-builder --win",
    "release": "npm run build && electron-builder --publish always"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.2.136",
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.17.10",
    "better-sqlite3": "^11.7.0",
    "chokidar": "^4.0.3",
    "electron-updater": "^6.8.3",
    "fuse.js": "^7.3.0",
    "mitt": "^3.0.1",
    "nanoid": "^5.0.9",
    "plantuml-encoder": "^1.4.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.1.0",
    "remark-gfm": "^4.0.1",
    "simple-git": "^3.36.0",
    "three": "^0.169.0",
    "troika-three-text": "^0.49.1",
    "zod": "^4.0.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@electron-toolkit/preload": "^3.0.1",
    "@electron-toolkit/utils": "^3.0.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.169.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/ui": "^4.1.7",
    "electron": "^32.2.7",
    "electron-builder": "^25.1.8",
    "electron-rebuild": "^3.2.9",
    "electron-vite": "^2.3.0",
    "happy-dom": "^20.9.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^4.1.7"
  }
}
